# General API settings
MEMONDEMAND_API_KEY=REPLACE_ME
MEMONDEMAND_API_BASE_URL=https://api.example.com/v1
MEMONDEMAND_API_MODEL=your-chat-model

# Optional embedding API override
# MEMONDEMAND_EMBED_API_KEY=REPLACE_ME
# MEMONDEMAND_EMBED_API_BASE_URL=https://api.example.com/v1
# MEMONDEMAND_EMBED_API_MODEL=your-embedding-model
# MEMONDEMAND_EMBED_DIM=1536

# Runtime settings (see README for details)
# MEMONDEMAND_EMBED_BACKEND=minilm
# MEMONDEMAND_L0_RETRIEVAL=bm25
# MEMONDEMAND_SKIP_L0_EMBED=1
# MEMONDEMAND_ANSWER_MODE=detailed_truncated
# MEMONDEMAND_INDEX_CACHE_DIR=/path/to/cache
# MEMONDEMAND_REPO_ROOT=/path/to/this/repo
